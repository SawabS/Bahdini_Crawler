# downloaded corpora: too large for git (~7.4 GB)
crawls/*/documents/

# Facebook group scrape: PDFs too large for git (~6 GB)
facebook/pdfs/
# Facebook session cookies: never commit
facebook/.fb_profile/
facebook/.vscode/

# Telegram channel downloads: books too large for git (~12 GB);
# the .download_state.json manifests stay tracked
telegram/downloads/**
!telegram/downloads/*/
!telegram/downloads/*/.download_state.json
# Telegram login session and credentials: never commit
telegram/.telegram/
telegram/.env

__pycache__/
*.pyc

# extracted text corpus: regenerate via scripts/extract_pipeline.py;
# the _manifest.jsonl files and summary stay tracked
extractions/*/*.txt
