# downloaded corpora: too large for git (~7.4 GB)
crawls/*/documents/
# language-classified and unmatched raw documents are also kept out of git
crawls/arabic_docs/
crawls/latin_kurdish_docs/
crawls/unmatched_restored_pdfs/

# Facebook group scrape: PDFs too large for git (~6 GB)
crawls/facebook/pdfs/
# Facebook session cookies: never commit
crawls/facebook/.fb_profile/
crawls/facebook/.vscode/

# Telegram channel downloads: books too large for git (~12 GB);
# the .download_state.json manifests stay tracked
crawls/telegram/downloads/**
!crawls/telegram/downloads/*/
!crawls/telegram/downloads/*/.download_state.json
# Telegram login session and credentials: never commit
crawls/telegram/.telegram/
crawls/telegram/.env

__pycache__/
*.pyc
venv/

# extracted text corpus: regenerate via scripts/extract_pipeline.py;
# manifests and summaries stay tracked, including safe/OCR classification indexes
extractions/**/*.txt
document_ai_sample/

# Gemini OCR pipeline artifacts: queue, page records, images, compiled corpus
gemini_ocr_pipeline/output/

.env
graphify-out
CLAUDE.md